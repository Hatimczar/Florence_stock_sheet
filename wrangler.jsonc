{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// Deliberately a different worker name from production ("florence-stock-sheet") so a
	// `cf:deploy` run from this repo can never overwrite the live production worker.
	"name": "florence-stock-sheet-v3",
	"workers_dev": true,
	"compatibility_date": "2024-09-23",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "florence-stock-sheet-v3"
		}
	],
	"kv_namespaces": [
		{
			// Its own namespace ("STOCK_SHEET_KV_V3_TEST") — deliberately NOT
			// production's namespace (40e606db6541491cadc1a8d7a4c99137), so this test
			// deploy never reads or writes real production data.
			"binding": "STOCK_SHEET_KV",
			"id": "e4486f1e931c4e7d90f651e94d500a1b"
		}
	]
	// No custom_domain route on purpose — this repo must never claim
	// stocks.florencetrading.me. Deploying (`npm run cf:deploy`) will only ever
	// publish to a workers.dev subdomain for testing.
}
